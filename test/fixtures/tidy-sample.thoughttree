{
  "version": 5,
  "graph": {
    "version": 5,
    "nodes": [
      {
        "id": "soil-q0",
        "role": "user",
        "content": "How does soil moisture affect seed germination?",
        "timestamp": 1750000060000,
        "contentUpdatedAt": 1750000060000
      },
      {
        "id": "soil-a0",
        "role": "assistant",
        "content": "Germination needs water uptake; too little stalls it, too much starves seeds of oxygen.",
        "timestamp": 1750000120000,
        "contentUpdatedAt": 1750000120000,
        "provider": "codex"
      },
      {
        "id": "soil-q1",
        "role": "user",
        "content": "Which moisture range is best for beans?",
        "timestamp": 1750000180000,
        "contentUpdatedAt": 1750000180000
      },
      {
        "id": "soil-a1",
        "role": "assistant",
        "content": "Roughly 60 to 80 percent of field capacity in most trials.",
        "timestamp": 1750000240000,
        "contentUpdatedAt": 1750000240000,
        "provider": "codex"
      },
      {
        "id": "light-q0",
        "role": "user",
        "content": "Does light matter for bean germination?",
        "timestamp": 1750000300000,
        "contentUpdatedAt": 1750000300000
      },
      {
        "id": "light-a0",
        "role": "assistant",
        "content": "Beans germinate in darkness; light matters after emergence.",
        "timestamp": 1750000360000,
        "contentUpdatedAt": 1750000360000,
        "provider": "codex"
      },
      {
        "id": "light-b-q0",
        "role": "user",
        "content": "What about seedling stretch?",
        "timestamp": 1750000420000,
        "contentUpdatedAt": 1750000420000
      },
      {
        "id": "light-b-a0",
        "role": "assistant",
        "content": "Low light makes seedlings stretch toward the source.",
        "timestamp": 1750000480000,
        "contentUpdatedAt": 1750000480000,
        "provider": "codex"
      },
      {
        "id": "synth-q",
        "role": "user",
        "content": "Combine both: a planting guide for beans.",
        "timestamp": 1750000540000,
        "contentUpdatedAt": 1750000540000
      },
      {
        "id": "synth-a",
        "role": "assistant",
        "content": "Sow into moist, not wet, soil; give full light once shoots appear.",
        "timestamp": 1750000600000,
        "contentUpdatedAt": 1750000600000,
        "provider": "codex"
      },
      {
        "id": "pests-q0",
        "role": "user",
        "content": "Common pests on bean seedlings?",
        "timestamp": 1750000660000,
        "contentUpdatedAt": 1750000660000
      },
      {
        "id": "pests-a0",
        "role": "assistant",
        "content": "Aphids, slugs and bean seed fly.",
        "timestamp": 1750000720000,
        "contentUpdatedAt": 1750000720000,
        "provider": "codex"
      },
      {
        "id": "pests-slug-q0",
        "role": "user",
        "content": "How do I stop slugs?",
        "timestamp": 1750000780000,
        "contentUpdatedAt": 1750000780000
      },
      {
        "id": "pests-slug-a0",
        "role": "assistant",
        "content": "Barriers, evening hand picking, or ferric phosphate.",
        "timestamp": 1750000840000,
        "contentUpdatedAt": 1750000840000,
        "provider": "codex"
      },
      {
        "id": "pests-aphid-q0",
        "role": "user",
        "content": "And aphids?",
        "timestamp": 1750000900000,
        "contentUpdatedAt": 1750000900000
      },
      {
        "id": "pests-aphid-a0",
        "role": "assistant",
        "content": "Water spray, ladybirds, or insecticidal soap.",
        "timestamp": 1750000960000,
        "contentUpdatedAt": 1750000960000,
        "provider": "codex"
      },
      {
        "id": "compost-q0",
        "role": "user",
        "content": "How long does compost take?",
        "timestamp": 1750001020000,
        "contentUpdatedAt": 1750001020000
      },
      {
        "id": "compost-a0",
        "role": "assistant",
        "content": "Two months hot, up to a year cold.",
        "timestamp": 1750001080000,
        "contentUpdatedAt": 1750001080000,
        "provider": "codex"
      },
      {
        "id": "compost-q1",
        "role": "user",
        "content": "Can I speed it up?",
        "timestamp": 1750001140000,
        "contentUpdatedAt": 1750001140000
      },
      {
        "id": "compost-a1",
        "role": "assistant",
        "content": "Turn it weekly and keep it as damp as a wrung sponge.",
        "timestamp": 1750001200000,
        "contentUpdatedAt": 1750001200000,
        "provider": "codex"
      },
      {
        "id": "tools-q0",
        "role": "user",
        "content": "Best hand tools for a small plot?",
        "timestamp": 1750001260000,
        "contentUpdatedAt": 1750001260000
      },
      {
        "id": "tools-a0",
        "role": "assistant",
        "content": "A hori-hori, a hoe and a good trowel.",
        "timestamp": 1750001320000,
        "contentUpdatedAt": 1750001320000,
        "provider": "codex"
      },
      {
        "id": "rain-q0",
        "role": "user",
        "content": "How do I size a rain barrel?",
        "timestamp": 1750001380000,
        "contentUpdatedAt": 1750001380000
      },
      {
        "id": "rain-a0",
        "role": "assistant",
        "content": "About 0.6 litres per square metre of roof per millimetre of rain.",
        "timestamp": 1750001440000,
        "contentUpdatedAt": 1750001440000,
        "provider": "codex"
      },
      {
        "id": "frost-q0",
        "role": "user",
        "content": "When is the last frost here?",
        "timestamp": 1750001500000,
        "contentUpdatedAt": 1750001500000
      },
      {
        "id": "frost-a0",
        "role": "assistant",
        "content": "Check a local frost date table; plant beans two weeks after.",
        "timestamp": 1750001560000,
        "contentUpdatedAt": 1750001560000,
        "provider": "codex"
      },
      {
        "id": "seeds-q0",
        "role": "user",
        "content": "How long do bean seeds keep?",
        "timestamp": 1750001620000,
        "contentUpdatedAt": 1750001620000
      },
      {
        "id": "seeds-a0",
        "role": "assistant",
        "content": "Three to four years if kept cool and dry.",
        "timestamp": 1750001680000,
        "contentUpdatedAt": 1750001680000,
        "provider": "codex"
      }
    ],
