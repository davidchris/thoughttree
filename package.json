{
  "name": "thoughttree",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest --root packages/graph-model",
    "test:run": "vitest run --root packages/graph-model",
    "typecheck": "tsc --noEmit -p packages/graph-model",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10",
    "eslint": "^10.10.0",
    "typescript": "~5.8",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "rollup": "^4.60.2",
    "vite": "^7.3.2"
  }
}
